# API base URL. Leave unset in dev (defaults to /api/v1, proxied by Vite).
# In production point it at the deployed backend, e.g. https://bomwatcher-api.onrender.com/api/v1
VITE_API_URL=

# Where the Vite dev server proxies /api (the FastAPI backend).
VITE_PROXY_TARGET=http://localhost:8000

# "true" simulates GitHub, repos and scans in the browser (no GitHub App needed).
# "false" uses the real backend endpoints.
VITE_USE_MOCKS=true
