# Copy to .env and fill in. Every variable maps to a field in app/core/config.py.

# development | test | production  (production disables /docs and enforces Postgres + explicit CORS)
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for local dev; PostgreSQL in production, e.g.
# postgresql+psycopg://user:password@host:5432/bomwatcher
DATABASE_URL=sqlite:///./bomwatcher.db

# Required, 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login/signup attempts allowed per IP per window
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated browser origins allowed to call the API (the React app)
CORS_ORIGINS=http://localhost:5173
# Comma-separated hostnames the API serves; set to your domain in production
ALLOWED_HOSTS=*

TRIAL_REPO_LIMIT=3

# GitHub App (GitHub → Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Either the path to the downloaded .pem, or its contents (\n escapes allowed)
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Composite Action the injected workflow runs
SCAN_ACTION_REF=devRaoRizwan/bomwatcher/github-action@main
